# Ship only the viewer and its assets — keep internal docs and build tooling out of the deploy.
# Deployed: index.html, slides-data.js, slides/, ai-markets-deck.pptx, vercel.json
node_modules
.claude
.vercel
.git
.gitignore
*.md
*.ps1
build-deck.js
package.json
package-lock.json
slides-images
logos
# The deck ships zero PNGs (slides render to JPG); exclude any so stray working
# files (e.g. "ChatGPT Image*.png") can never leak into the deploy.
*.png
